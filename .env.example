# Receipt Roamer — Required Environment Variables
# Copy this to .env for local dev, or set in Railway's Variables tab for production.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-public-key>

# Service-role key -- bypasses RLS. Server-side only, never exposed to the browser.
# Required by src/integrations/supabase/client.server.ts (extraction pipeline,
# inbound email, CondoTracker feed).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Exposed to the browser (Vite replaces import.meta.env.VITE_*)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-public-key>

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/apikey
# Used server-side only (never exposed to the browser).
GEMINI_API_KEY=<your-gemini-api-key>

# ── Inbound email (Mailgun) ───────────────────────────────────────────────────
# Sign up at https://mailgun.com, enable Inbound Processing for your domain,
# and copy the Webhook Signing Key from Settings → Webhooks.
# Point your Mailgun route's webhook URL to: https://<your-app>/api/email-inbound
# Allowed sender addresses are managed in-app under Settings (allowed_sender_emails table),
# not via env var — only emails from an address in that table will be processed.
MAILGUN_WEBHOOK_SIGNING_KEY=<key-from-mailgun-settings-webhooks>

# The inbound email address shown in the Upload page UI (VITE_ prefix = browser-visible).
# This is the address receipts are FORWARDED TO (e.g. receipts@mg.yourdomain.com).
# NOT the sender — allowed senders are configured via the in-app Settings page.
VITE_INBOUND_EMAIL=receipts@mg.yourdomain.com

# ── CondoTracker sync (read-only) ──────────────────────────────────────────────
# Connection string for the READ-ONLY Postgres role on CondoTracker's database
# (receiptroamer_ro — see scripts/sync-from-condotracker.mjs for the setup SQL).
# This account must only have SELECT on condominiums/owners — never use an
# admin/write credential here.
CONDOTRACKER_DATABASE_URL=postgresql://receiptroamer_ro:password@condotracker-host:5432/condotracker?sslmode=require

# ── Secure Login Credentials ──────────────────────────────────────────────────
# Set these in your production environment to protect the application.
APP_LOGIN_EMAIL=admin@example.com
APP_LOGIN_PASSWORD=your_secure_password_here

# ── CondoTracker feed (outbound, read-only) ───────────────────────────────────
# Shared secret protecting GET /api/condotracker-feed, which CondoTracker polls
# nightly to stage new expenses/income payments in its review queue. Set the
# SAME value as RECEIPT_ROAMER_API_KEY on the CondoTracker side.
# Generate one with: openssl rand -hex 32
CONDOTRACKER_API_KEY=<shared-secret>
